# Application configuration
FLASK_ENV=development
SECRET_KEY=replace-with-secret-key
JWT_SECRET_KEY=replace-with-jwt-secret

# PostgreSQL configuration
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_DB=taskmanager

# Database connection
DATABASE_URL=postgresql+psycopg://taskmanager:replace-with-database-password@db:5432/taskmanager
